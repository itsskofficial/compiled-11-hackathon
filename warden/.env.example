# Warden environment. Copy to .env.local and fill in what you have.
# Every one of these is optional except ANTHROPIC_API_KEY: the app runs with any
# subset configured and degrades visibly rather than crashing.

# ---------------------------------------------------------------------------
# 1. REQUIRED — the vision loop
# ---------------------------------------------------------------------------
# Without this the classifier returns a canned assessment, which is disclosed in
# the evidence report as a fallback. The demo still runs; it just is not live.
ANTHROPIC_API_KEY=

# Optional. The route already tries claude-sonnet-5, then claude-sonnet-4-5, then
# older ids, advancing past a 404. Set this to pin one explicitly.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# 2. The real escalation call — Phonely (needs Twilio underneath)
# ---------------------------------------------------------------------------
# Campaign webhook URL from Phonely: campaign trigger source = Webhook.
PHONELY_CAMPAIGN_WEBHOOK=
# The on-call mobile in E.164. On a Twilio trial this number must be verified.
ONCALL_PHONE_NUMBER=
# Only if your Phonely webhook requires a bearer token.
# PHONELY_API_KEY=

# The public HTTPS origin Phonely posts back to, from cloudflared.
# Used for reference; the call flow's API Request block needs the full URL.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# 3. Vendor validation — VOYGR
# ---------------------------------------------------------------------------
# POST https://dev.voygr.tech/signup emails you a key. No identity check.
VOYGR_API_KEY=
# VOYGR_BASE_URL=https://dev.voygr.tech

# ---------------------------------------------------------------------------
# 4. Auth — Hexclave
# ---------------------------------------------------------------------------
# From app.hexclave.com. When these are absent the dashboard is simply public and
# the operator falls back to the fixture manager, so nothing breaks.
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
HEXCLAVE_SECRET_SERVER_KEY=

# ---------------------------------------------------------------------------
# 5. Camera pinning
# ---------------------------------------------------------------------------
# The wrong camera on the filming machine is a real failure mode. Open the
# dashboard, run `navigator.mediaDevices.enumerateDevices()` in the console, and
# paste the deviceId of the camera you want here.
# NEXT_PUBLIC_CAMERA_DEVICE_ID=
